{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "clots-sidecar",
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/bunfig.toml", "$TURBO_ROOT$/packages/oxlint/src/**"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {}
  },
  "globalPassThroughEnv": [
    "CLOTS_HOME",
    "CLOTS_PORT",
    "CLAUDE_CONFIG_DIR",
    "AGENT_BROWSER_EXECUTABLE_PATH",
    "CLOTS_WEB_DEV_PORT",
    "CLOTS_TAILNET"
  ]
}
