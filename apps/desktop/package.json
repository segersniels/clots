{
  "name": "@clots/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The clots desktop app",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun run --cwd ../web build:setup && bun build src/main.ts src/preload.ts --target=node --format=cjs --external electron --outdir dist --entry-naming '[name].cjs'",
    "start": "bun run build && electron .",
    "package:mac": "bun run --cwd ../.. build:cli && bun run build && electron-builder --mac -c.mac.identity=- -c.mac.hardenedRuntime=false -c.extraMetadata.version=$(bun -p \"require('../../package.json').version\") && open release/Clots.dmg",
    "lint": "oxlint . && bun fmt --check .",
    "lint:fix": "oxlint . --fix && bun fmt .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clots/contracts": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.12",
    "typescript": "catalog:"
  },
  "build": {
    "appId": "foo.clots.desktop",
    "productName": "Clots",
    "files": [
      "dist/**",
      "resources/**"
    ],
    "extraResources": [
      {
        "from": "../../dist/clots-${platform}-${arch}",
        "to": "clots"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Clots.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "segersniels",
      "repo": "clots"
    }
  }
}
