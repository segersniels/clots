{
  "name": "clots",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "spikes/e2e"
    ],
    "catalog": {
      "effect": "4.1.5",
      "@effect/platform-bun": "4.1.5",
      "@effect/sql-sqlite-bun": "4.1.5",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.5"
    }
  },
  "scripts": {
    "dev": "CLOTS_WEB_DEV_PORT=5173 turbo run dev",
    "build": "turbo run build",
    "build:cli": "turbo run build --filter=@clots/web --filter=@clots/sidecar && bun apps/server/scripts/build-cli.ts",
    "lint": "bun fmt --check .oxlintrc.json bunfig.toml && turbo run lint",
    "lint:fix": "bun fmt .oxlintrc.json bunfig.toml && turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "start": "bun run --cwd apps/server start"
  },
  "devDependencies": {
    "@clots/oxlint": "workspace:*",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxlint": "^1.95.0",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "electron"
  ]
}
